# 301 redirects for Cloudflare Pages (Pages does not read .htaccess).
# Ported from docs/htaccess.txt. First match wins. Files in public/ are copied
# to the build root, where Pages reads this file.

# Canonical host: send www.pedaver.com to the bare apex, once, over HTTPS.
https://www.pedaver.com/*  https://pedaver.com/:splat  301!

