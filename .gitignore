# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# deploy artifact (regenerated by the build; do not commit)
/pedaver-site.zip

# machine-local Claude Code settings (contains per-PC paths, e.g. hooks)
/.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
